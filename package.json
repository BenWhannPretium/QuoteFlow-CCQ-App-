{
  "name": "quoteflow",
  "private": true,
  "description": "QuoteFlow: Pretium Packaging Commercial Capital Quoting (CCQ) web app",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ccq/api --filter=@ccq/web",
    "build": "turbo run build",
    "lint": "turbo run lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "e2e": "turbo run e2e --filter=@ccq/web",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build",
    "db:migrate": "pnpm --filter @ccq/db db:migrate",
    "db:seed": "pnpm --filter @ccq/db db:seed",
    "db:reset": "pnpm --filter @ccq/db db:reset",
    "db:dictionary": "pnpm --filter @ccq/db db:dictionary",
    "db:sf-fixture": "pnpm --filter @ccq/db db:sf-fixture",
    "uat:defects": "pnpm --filter @ccq/db uat:defects"
  },
  "prettier": "@ccq/config/prettier",
  "devDependencies": {
    "@ccq/config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-xcx6-jx8p-x3h5"
      ]
    }
  }
}
