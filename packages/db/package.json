{
  "name": "@ccq/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM schema, migrations and seeds (PostgreSQL 16)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./repos": "./src/repos/index.ts",
    "./seeds": "./seeds/index.ts",
    "./personas": "./seeds/synthetic/personas.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/cli/reset.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:dictionary": "tsx src/cli/dictionary.ts",
    "db:sf-fixture": "tsx src/cli/sf-fixture.ts"
  },
  "dependencies": {
    "@ccq/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@ccq/config": "workspace:*",
    "@ccq/integrations": "workspace:*",
    "@faker-js/faker": "10.6.0",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
