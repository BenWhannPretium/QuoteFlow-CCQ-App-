{
  "name": "@ccq/api",
  "version": "0.0.0",
  "private": true,
  "description": "QuoteFlow Fastify API (serves the SPA in production)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/sensible": "6.0.7",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ccq/config": "workspace:*",
    "@ccq/contracts": "workspace:*",
    "@ccq/db": "workspace:*",
    "@ccq/domain": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-orm": "0.45.4",
    "pino-pretty": "13.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
