# QuoteFlow environment variables. Copy to `.env` for local dev (`.env` is git-ignored).
# In Azure, every value comes from App Service settings / Key Vault references (B-20). Never commit secrets.

# --- Runtime ---------------------------------------------------------------
# development | test | production. The API refuses to boot with AUTH_MODE=dev in production.
NODE_ENV=development
# API listen port and host. The web dev server (5173) proxies /api to this port.
PORT=3000
HOST=0.0.0.0
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Git SHA of the build; reported by GET /api/v1/health. CI/CD sets it, "dev" locally.
GIT_SHA=dev

# --- Database --------------------------------------------------------------
# Postgres 16. Matches docker-compose.yml locally.
DATABASE_URL=postgres://ccq:ccq@localhost:5432/ccq
# Integration tests: a separate database, created and migrated automatically by the test global setup.
TEST_DATABASE_URL=postgres://ccq:ccq@localhost:5432/ccq_test

# --- Auth ------------------------------------------------------------------
# entra = Microsoft Entra ID JWTs (required in test/prod). dev = fake users + role switcher (local only).
AUTH_MODE=dev
# Values come from IT at M2 (app registrations). Placeholders until then; none of them are secrets.
# Entra tenant (directory) ID. Required when AUTH_MODE=entra.
ENTRA_TENANT_ID=
# SPA app registration client ID (public client, redirect URIs = app origins). Required when AUTH_MODE=entra.
ENTRA_SPA_CLIENT_ID=
# API app registration client ID. Optional: v2 access tokens carry it as `aud`, so it is accepted too.
ENTRA_API_CLIENT_ID=
# App ID URI of the API registration, api://<api-client-id>. Required when AUTH_MODE=entra.
ENTRA_API_AUDIENCE=
# Delegated scope exposed by the API registration (the SPA requests <audience>/<scope>).
ENTRA_API_SCOPE=access_as_user

# --- Salesforce (B-06, read-only) -------------------------------------------
# fake = synthetic fixture (default; local dev and CI). live = jsforce against the org.
SF_MODE=fake
# How live logs in: jwt (certificate: SF_USERNAME + SF_PRIVATE_KEY) or client_credentials (SF_CLIENT_SECRET;
# runs as the External Client App's "Run As" user). Production uses client_credentials.
SF_AUTH_FLOW=jwt
# jwt: https://test.salesforce.com (sandbox) or https://login.salesforce.com (production).
# client_credentials: the org's My Domain URL, e.g. https://pretiumpkg.my.salesforce.com.
SF_LOGIN_URL=https://test.salesforce.com
# External Client App consumer key (Rachel Dew). Required when SF_MODE=live. Not a secret.
SF_CLIENT_ID=
# client_credentials: the consumer secret. SECRET: in Azure a Key Vault reference. Never commit it.
SF_CLIENT_SECRET=
# jwt: the read-only integration user.
SF_USERNAME=integration@pretiumpkg.com.uat
# jwt: PEM private key of the app's certificate. SECRET: in Azure this is a
# Key Vault reference; locally paste it on one line with \n for newlines. Never commit it.
SF_PRIVATE_KEY=
# Salesforce REST API version.
SF_API_VERSION=62.0
# Delta sync interval in minutes (0 = no schedule; Admin → Integrations can still run it).
SF_SYNC_INTERVAL_MINUTES=15
# Live contract test against UAT (read-only): SF_LIVE_TEST=1 pnpm --filter @ccq/integrations test
# SF_LIVE_TEST=

# --- Pricing history (B-15) -----------------------------------------------------
# No settings: there is no live connection to the retired pricing app. An Admin imports its export
# (Admin → Integrations → Pricing history). Locally, `pnpm db:seed --synthetic` loads synthetic history.

# --- Attachments (B-16) -----------------------------------------------------
# local = files on disk (default; dev and CI; refused in production). sharepoint = Microsoft Graph, app-only,
# Sites.Selected (write) on the CCQ site (the target, from M7). blob = a private Azure Blob container (fallback).
FILESTORE_MODE=local
# local: where files go, relative to the API's working directory (git-ignored).
FILESTORE_LOCAL_DIR=.data/files
# sharepoint: the CCQ site (recorded at M7) and its document library (drive) id. Not secrets.
SP_SITE_ID=
SP_DRIVE_ID=
# blob: https://<account>.blob.core.windows.net and the private container.
# BLOB_ACCOUNT_URL=
# BLOB_CONTAINER=
# Credentials: the App Service managed identity by default (client id of a user-assigned one here).
# GRAPH_MI_CLIENT_ID=
# Local development against the TEST site only (refused in production). SECRET: never commit it.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# Live contract test against the test site: SP_LIVE_TEST=1 SP_DRIVE_ID=… GRAPH_*=… pnpm --filter @ccq/integrations test
# SP_LIVE_TEST=

# B-13: proposal validity expiry job (flags + notifies the KAM; never closes). 0 = off.
VALIDITY_EXPIRY_INTERVAL_HOURS=24

# --- Notification email (B-18) ------------------------------------------------
# graph = Microsoft Graph sendMail from the shared mailbox, app-only (Mail.Send, restricted to that one mailbox
# by an Exchange application access policy; credentials as for attachments above). smtp = mailpit locally
# (`docker compose up -d mailpit`, inbox UI http://localhost:8025). fake = nothing is sent. Production: graph only.
MAIL_MODE=fake
# The shared mailbox the email comes from (IT names it at M7).
MAIL_FROM=ccq-noreply@pretiumpkg.com
# smtp only: mailpit.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Seconds between email dispatch runs (the dispatcher also builds the 7:00 AM Central to-qualify digest). 0 = off.
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=60
# B-19: seconds each API instance caches GET /config/public (an admin change clears it on that instance).
CONFIG_CACHE_SECONDS=60

# --- URLs ------------------------------------------------------------------
# Public base URL users reach the app on (web dev server locally).
APP_BASE_URL=http://localhost:5173

# --- Optional --------------------------------------------------------------
# Requests per minute per client before HTTP 429.
RATE_LIMIT_MAX=300
# Override where the production API serves the built SPA from (defaults to apps/web/dist).
# WEB_DIST_DIR=
# Where `pnpm dev` (vite) proxies /api.
# VITE_API_PROXY_TARGET=http://localhost:3000
